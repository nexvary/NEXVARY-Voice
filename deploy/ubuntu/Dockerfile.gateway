FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/voice
COPY gateway/pyproject.toml ./pyproject.toml
COPY gateway/voice_gateway ./voice_gateway
RUN python -m pip install --no-cache-dir .
RUN groupadd --gid 10001 nvvoice && useradd --uid 10001 --gid nvvoice --create-home --shell /usr/sbin/nologin nvvoice
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn","voice_gateway.api:app","--host","0.0.0.0","--port","8000","--no-proxy-headers","--workers","1"]
