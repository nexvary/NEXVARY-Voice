# Copy to .env and keep outside version control. Never commit the actual secret.
NEXVARY_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET
NEXVARY_VOICE_PORT=18781
\n# Model cache is installed explicitly; remote Whisper model download is disabled at runtime.
NEXVARY_WHISPER_MODEL=small
# Replace with paths to EXISTING model files inside the dedicated volume.
NEXVARY_PIPER_VOICES={"ar":"/models/voices/ar.onnx","en":"/models/voices/en.onnx","hi":"/models/voices/hi.onnx"}
